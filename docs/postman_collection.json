{
  "info": {"name": "Jajal Medical Cases API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key": "base", "value": "http://127.0.0.1:8000/api"},
    {"key": "token", "value": ""},
    {"key": "viewer_token", "value": ""}
  ],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
  "item": [
    {"name": "Login (Admin) - saves token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().data.token);"]}}], "request": {"method": "POST", "auth": {"type": "noauth"}, "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/login", "body": {"mode": "raw", "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin@12345\"}"}}},
    {"name": "Login (Viewer) - saves viewer_token", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('viewer_token', pm.response.json().data.token);"]}}], "request": {"method": "POST", "auth": {"type": "noauth"}, "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/login", "body": {"mode": "raw", "raw": "{\"email\":\"viewer@example.com\",\"password\":\"Viewer@12345\"}"}}},
    {"name": "List cases", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base}}/cases?status=Planning&priority=High&sort=case_number&direction=asc"}},
    {"name": "Get case", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base}}/cases/1"}},
    {"name": "Create case (Admin) - expect 201", "request": {"method": "POST", "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/cases", "body": {"mode": "raw", "raw": "{\"case_number\":\"CASE-0100\",\"patient_reference\":\"PT-0100AB\",\"surgeon_name\":\"Dr. Rao\",\"implant_type\":\"Hip Implant\",\"status\":\"Draft\",\"priority\":\"High\",\"surgery_date\":\"2026-12-15\"}"}}},
    {"name": "Create case - duplicate number, expect 422", "request": {"method": "POST", "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/cases", "body": {"mode": "raw", "raw": "{\"case_number\":\"CASE-0001\",\"patient_reference\":\"PT-0100AB\",\"surgeon_name\":\"Dr. Rao\",\"implant_type\":\"Hip Implant\",\"status\":\"Draft\",\"priority\":\"High\"}"}}},
    {"name": "Create case as Viewer - expect 403", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{viewer_token}}", "type": "string"}]}, "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/cases", "body": {"mode": "raw", "raw": "{}"}}},
    {"name": "Update case (changes status, adds history)", "request": {"method": "PUT", "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}], "url": "{{base}}/cases/1", "body": {"mode": "raw", "raw": "{\"case_number\":\"CASE-0001\",\"patient_reference\":\"PT-0001AB\",\"surgeon_name\":\"Dr. Rao\",\"implant_type\":\"Hip Implant\",\"status\":\"Approved\",\"priority\":\"Low\"}"}}},
    {"name": "Delete case as Viewer - expect 403", "request": {"method": "DELETE", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{viewer_token}}", "type": "string"}]}, "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base}}/cases/2"}},
    {"name": "Delete case (Admin) - run last", "request": {"method": "DELETE", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base}}/cases/2"}},
    {"name": "Logout", "request": {"method": "POST", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base}}/logout"}}
  ]
}
